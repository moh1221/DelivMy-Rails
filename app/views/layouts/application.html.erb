<!doctype html>
<html lang="en">
<head>
  <title>DelivMy</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "bootstrap.min", "application" %>
  <%= javascript_include_tag "application", defer: true %>
</head>
<body class="<%= controller_name %> <%= action_name %>">
  <nav class="navbar navbar-expand-lg" aria-label="Main navigation">
    <div class="container">
      <%= link_to "DelivMy", root_path, class: "navbar-brand" %>
      <button type="button" class="navbar-toggler" data-menu-toggle aria-controls="primary-navigation" aria-expanded="false">Menu</button>
      <div class="collapse navbar-collapse" id="primary-navigation">
        <ul class="navbar-nav me-auto">
          <% if current_user %>
            <li><%= link_to "Search", search_path, class: "nav-link" %></li>
            <li><%= link_to "My Requests", requests_path, class: "nav-link" %></li>
            <li><%= link_to "New Request", new_request_path, class: "nav-link" %></li>
            <li><%= link_to "My Deliveries", delivers_path, class: "nav-link" %></li>
          <% end %>
        </ul>
        <ul class="navbar-nav">
          <% if current_user %>
            <li><%= link_to "Profile", profile_path, class: "nav-link" %></li>
            <li><%= button_to "Log out", logout_path, method: :delete, class: "btn btn-link nav-link" %></li>
          <% else %>
            <li><%= link_to "Login", login_path, class: "nav-link" %></li>
            <li><%= link_to "Sign up", signup_path, class: "nav-link" %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>
  <main>
    <% if notice.present? %><div class="alert alert-success" role="status"><%= notice %></div><% end %>
    <% if alert.present? %><div class="alert alert-danger" role="alert"><%= alert %></div><% end %>
    <%= yield %>
  </main>
  <% if ENV["GOOGLE_MAPS_BROWSER_KEY"].present? && ((controller_name == "search" && action_name == "index") || (controller_name == "requests" && %w[new create].include?(action_name))) %>
    <%= javascript_include_tag "https://maps.googleapis.com/maps/api/js?#{ { key: ENV['GOOGLE_MAPS_BROWSER_KEY'], callback: 'initializeDelivMap', loading: 'async' }.to_query }", defer: true %>
  <% end %>
</body>
</html>
