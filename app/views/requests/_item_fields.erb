<div class="fields">
  <%= f.label :ItemsName, "Item" %>
  <%= f.text_field :ItemsName, class: "form-control", placeholder: "Item name" %>
  <%= f.label :ItemDescription, "Description" %>
  <%= f.text_field :ItemDescription, class: "form-control", placeholder: "Optional details" %>
  <%= f.hidden_field :_destroy %>
  <button type="button" class="btn btn-link" data-remove-item>Remove item</button>
</div>
